# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real credentials.
# Note: `mage dev` and `mage run` supply DATABASE_URL automatically when not set.

# Required: PostgreSQL connection string
# Default used by mage targets: postgres://grpc:grpc@localhost:5433/grpc_experiment?sslmode=disable
DATABASE_URL=postgres://grpc:grpc@localhost:5433/grpc_experiment?sslmode=disable

# Optional: port the gRPC server listens on (default: 50051)
GRPC_PORT=50051

# Optional: port the HTTP/JSON gateway listens on (default: 8080)
HTTP_PORT=8080
