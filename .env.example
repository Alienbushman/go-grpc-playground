# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real credentials.

# Required: PostgreSQL connection string
# For local dev with docker compose: postgres://grpc:grpc@localhost:5433/grpc_experiment?sslmode=disable
DATABASE_URL=

# Optional: port the gRPC server listens on (default: 50051)
GRPC_PORT=50051
